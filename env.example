# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Image Upload Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Events Database Supabase Configuration (separate database)
EVENTS_SUPABASE_URL=https://your-events-project-id.supabase.co
EVENTS_SUPABASE_SERVICE_ROLE_KEY=your-events-service-role-key-here

# Authentication Credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=your-secure-password-here
